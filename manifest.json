{
  "manifest_version": 3,
  "name": "go+",
  "version": "0.9.46",
  "description": "Go Hilton availability search engine.",
  "incognito": "split",
  "permissions": [
    "storage",
    "webRequest",
    "tabs",
    "cookies",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.hilton.com/*",
    "https://*.hilton.com/*",
    "https://seats.aero/*",
    "https://nominatim.openstreetmap.org/*",
    "https://cdn.jsdelivr.net/*",
    "https://*.currency-api.pages.dev/*",
    "https://maps.googleapis.com/*",
    "https://*.googleapis.com/*",
    "https://*.gstatic.com/*",
    "https://*.google.com/*",
    "https://*.ggpht.com/*"
  ],
  "sandbox": {
    "pages": ["web/map-sandbox.html"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com; object-src 'self'; worker-src 'self' blob:"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "hilton_headers",
        "enabled": true,
        "path": "rules/hilton-headers.json"
      }
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open go+ search",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
